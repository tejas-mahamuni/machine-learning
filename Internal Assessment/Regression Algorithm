.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-6c89a1b3-a5b7-4428-9ea3-81d9a4f80caa');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Split Ready | X_train: (42163, 22) | X_test: (10541, 22)\n"]}],"source":["# CELL 1: Setup, Google Drive Dataset Loading, Canonical Split & 2x2 Plotter\n","import os\n","import time\n","import warnings\n","import joblib\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from abc import ABC, abstractmethod\n","from google.colab import drive\n","\n","from sklearn.base import BaseEstimator, RegressorMixin\n","from sklearn.model_selection import train_test_split, KFold, cross_val_score\n","from sklearn.preprocessing import StandardScaler, PolynomialFeatures\n","from sklearn.impute import SimpleImputer\n","from sklearn.pipeline import make_pipeline\n","from sklearn.linear_model import LinearRegression, SGDRegressor, Ridge\n","from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n","\n","warnings.filterwarnings(\"ignore\")\n","sns.set_theme(style=\"whitegrid\")\n","\n","# 1. Mount Google Drive & Load Feature Store\n","if not os.path.exists('/content/drive'):\n","    drive.mount('/content/drive')\n","\n","# 2. Project Directory\n","PROJECT_DIR = '/content/drive/MyDrive/Mini Project/dataset'\n","\n","# Create project directory if it does not exist\n","os.makedirs(PROJECT_DIR, exist_ok=True)\n","FIG_DIR = os.path.join(PROJECT_DIR, 'figures')\n","MODELS_DIR = os.path.join(PROJECT_DIR, 'models')\n","os.makedirs(FIG_DIR, exist_ok=True)\n","os.makedirs(MODELS_DIR, exist_ok=True)\n","\n","# 3. Load Dataset\n","DATA_PATH = os.path.join(PROJECT_DIR, 'aqi_2026.csv')\n","df = pd.read_csv(DATA_PATH)\n","\n","print(\"Dataset loaded successfully!\")\n","print(\"Dataset Shape:\", df.shape)\n","display(df.head())\n","\n","# 4. Canonical Feature Sets (No Target Leakage & No Collinear Duplicates)\n","FEATURES = [\n","    'pm2_5', 'pm10', 'carbon_monoxide', 'nitrogen_dioxide', 'sulphur_dioxide',\n","    'ozone', 'aerosol_optical_depth', 'dust', 'uv_index',\n","    'temperature_2m', 'relative_humidity_2m', 'dew_point_2m', 'precipitation',\n","    'surface_pressure', 'cloud_cover', 'wind_speed_10m', 'wind_direction_10m',\n","    'shortwave_radiation', 'pm_ratio', 'stagnation_index', 'photochemical_index', 'is_rush_hour'\n","]\n","POLY_FEATURES = ['pm2_5', 'pm10', 'dust', 'ozone', 'nitrogen_dioxide', 'temperature_2m']\n","TARGET = 'us_aqi'\n","\n","X = df[FEATURES].copy()\n","y = df[TARGET].values\n","\n","# 5. Single Unified Split Reused Across ALL Models\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)\n","\n","pipelines_registry = {}\n","benchmark_results = []\n","\n","class BaseRegressor(BaseEstimator, RegressorMixin, ABC):\n","    \"\"\"DRY Parent Class allowing custom NumPy models to plug directly into make_pipeline().\"\"\"\n","    @staticmethod\n","    def _add_bias(X: np.ndarray) -> np.ndarray:\n","        X_arr = np.asarray(X, dtype=float)\n","        if X_arr.ndim == 1:\n","            X_arr = X_arr.reshape(-1, 1)\n","        return np.c_[np.ones((X_arr.shape[0], 1)), X_arr]\n","\n","    @abstractmethod\n","    def fit(self, X, y):\n","        pass\n","\n","    @abstractmethod\n","    def predict(self, X) -> np.ndarray:\n","        pass\n","\n","def benchmark_pipeline(key: str, label: str, pipeline, X_tr, X_te, y_tr, y_te) -> pd.DataFrame:\n","    \"\"\"Fits any make_pipeline (Scratch or Sklearn), registers it, and records test metrics.\"\"\"\n","    t0 = time.time()\n","    pipeline.fit(X_tr, y_tr)\n","    train_time = time.time() - t0\n","\n","    y_pred = pipeline.predict(X_te)\n","    mse = mean_squared_error(y_te, y_pred)\n","    metrics = {\n","        'Pipeline_Key': key,\n","        'Model': label,\n","        'MSE': round(mse, 4),\n","        'RMSE': round(np.sqrt(mse), 4),\n","        'MAE': round(mean_absolute_error(y_te, y_pred), 4),\n","        'R2_Score': round(r2_score(y_te, y_pred), 4),\n","        'Train_Time_s': round(train_time, 4)\n","    }\n","    pipelines_registry[key] = pipeline\n","    benchmark_results.append(metrics)\n","    return pd.DataFrame([metrics])\n","\n","def plot_without_vs_with_lib(algo_title: str, scratch_pipe, lib_pipe, X_te_sub: pd.DataFrame, y_te: np.ndarray, save_name: str):\n","    \"\"\"\n","    Renders dedicated 2x2 graphs for BOTH Without Library (Left) and With Library (Right):\n","      - Row 1: Actual fitted regression line / curve along primary predictor 'pm2_5'\n","      - Row 2: Actual vs. Predicted scatter + OLS best-fit trendline\n","    \"\"\"\n","    fig, axes = plt.subplots(2, 2, figsize=(16, 10))\n","    sample_idx = np.random.RandomState(42).choice(len(X_te_sub), size=min(1500, len(X_te_sub)), replace=False)\n","\n","    # Smooth PM2.5 grid (holding other features at median for multivariate pipelines)\n","    pm25_grid = np.linspace(X_te_sub['pm2_5'].min(), X_te_sub['pm2_5'].quantile(0.99), 200)\n","    grid_df = pd.DataFrame(np.tile(X_te_sub.median().values, (len(pm25_grid), 1)), columns=X_te_sub.columns)\n","    grid_df['pm2_5'] = pm25_grid\n","\n","    configs = [\n","        (0, \"Without Library (Scratch Pipeline)\", scratch_pipe, '#d62728'),\n","        (1, \"With Library (Sklearn Pipeline)\", lib_pipe, '#1f77b4')\n","    ]\n","\n","    for col_idx, side_label, pipe, color in configs:\n","        # Row 0: Actual Fitted Regression Line / Curve over Test Data\n","        y_curve = pipe.predict(grid_df)\n","        axes[0, col_idx].scatter(\n","            X_te_sub['pm2_5'].iloc[sample_idx], y_te[sample_idx],\n","            alpha=0.22, s=14, color='#7f7f7f', label='Test Data'\n","        )\n","        axes[0, col_idx].plot(pm25_grid, y_curve, color=color, linewidth=2.8, label='Fitted Regression Line/Curve')\n","        axes[0, col_idx].set_title(f'{algo_title} — {side_label}\\n(Fitted Regression Line along PM2.5)')\n","        axes[0, col_idx].set_xlabel('PM2.5 Concentration (µg/m³)')\n","        axes[0, col_idx].set_ylabel('US AQI')\n","        axes[0, col_idx].legend(loc='upper left')\n","        axes[0, col_idx].grid(True, linestyle='--', alpha=0.5)\n","\n","        # Row 1: Actual vs. Predicted Regression Fit\n","        y_pred = pipe.predict(X_te_sub)\n","        r2_val = r2_score(y_te, y_pred)\n","        axes[1, col_idx].scatter(y_te[sample_idx], y_pred[sample_idx], alpha=0.25, s=14, color=color, label=f'Predictions (R²={r2_val:.4f})')\n","\n","        lims = [0, max(y_te.max(), y_pred.max())]\n","        axes[1, col_idx].plot(lims, lims, 'k--', linewidth=1.6, label='Ideal Fit (y = x)')\n","        m, b = np.polyfit(y_te, y_pred, 1)\n","        axes[1, col_idx].plot(np.array(lims), m * np.array(lims) + b, color='#2ca02c', linewidth=2.2, label=f'Trend Line (slope={m:.2f})')\n","\n","        axes[1, col_idx].set_title(f'{algo_title} — {side_label}\\n(Actual vs. Predicted Regression Line)')\n","        axes[1, col_idx].set_xlabel('Actual US AQI')\n","        axes[1, col_idx].set_ylabel('Predicted US AQI')\n","        axes[1, col_idx].legend(loc='upper left')\n","        axes[1, col_idx].grid(True, linestyle='--', alpha=0.5)\n","\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(FIG_DIR, save_name), dpi=300, bbox_inches='tight')\n","    plt.show()\n","\n","print(f\"Split Ready | X_train: {X_train.shape} | X_test: {X_test.shape}\")"]},{"cell_type":"markdown","source":["### 2. Simple Linear Regression (Without Library vs. With Library Pipelines & Graphs)\n","**One-Liner:** Fits univariate `pm2_5` $\\rightarrow$ `us_aqi` models using both a custom closed-form class and `LinearRegression` inside separate `make_pipeline` objects, then renders dedicated regression line graphs for each.\n","The left column displays the Without-Library custom regression line and Actual-vs-Predicted fit, while the right column displays the With-Library `scikit-learn` pipeline graphs."],"metadata":{"id":"yO6pNVw7Odn5"}},{"cell_type":"code","source":["# CELL 2: Simple Linear Regression — Without Lib Pipeline vs. With Lib Pipeline + Separate Graphs\n","\n","# --- A. WITHOUT LIBRARY: Custom OOP Class ---\n","class SimpleLinearRegressor(BaseRegressor):\n","    \"\"\"Univariate Closed-Form OLS: w1 = Cov(x, y) / Var(x), w0 = mean(y) - w1 * mean(x).\"\"\"\n","    def fit(self, X, y):\n","        x_arr = np.asarray(X, dtype=float).ravel()\n","        y_arr = np.asarray(y, dtype=float).ravel()\n","        x_mean, y_mean = np.mean(x_arr), np.mean(y_arr)\n","        self.w1_ = np.sum((x_arr - x_mean) * (y_arr - y_mean)) / np.sum((x_arr - x_mean) ** 2)\n","        self.w0_ = y_mean - self.w1_ * x_mean\n","        return self\n","\n","    def predict(self, X) -> np.ndarray:\n","        return self.w0_ + self.w1_ * np.asarray(X, dtype=float).ravel()\n","\n","slr_scratch_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    SimpleLinearRegressor()\n",")\n","res_1a = benchmark_pipeline(\n","    \"slr_scratch\", \"1a. Simple LR (Without Lib Pipeline)\",\n","    slr_scratch_pipe, X_train[['pm2_5']], X_test[['pm2_5']], y_train, y_test\n",")\n","\n","# --- B. WITH LIBRARY: Scikit-Learn Pipeline ---\n","slr_lib_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    LinearRegression()\n",")\n","res_1b = benchmark_pipeline(\n","    \"slr_lib\", \"1b. Simple LR (With Lib Pipeline)\",\n","    slr_lib_pipe, X_train[['pm2_5']], X_test[['pm2_5']], y_train, y_test\n",")\n","\n","# --- C. COMPARISON TABLE & SEPARATE GRAPHS FOR BOTH ---\n","print(\"=== SIMPLE LINEAR REGRESSION COMPARISON (pm2_5 -> us_aqi) ===\")\n","display(pd.concat([res_1a, res_1b], ignore_index=True))\n","\n","plot_without_vs_with_lib(\n","    algo_title=\"Simple Linear Regression\",\n","    scratch_pipe=slr_scratch_pipe,\n","    lib_pipe=slr_lib_pipe,\n","    X_te_sub=X_test[['pm2_5']],\n","    y_te=y_test,\n","    save_name=\"01_simple_lr_without_vs_with_lib.png\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":661},"id":"Ysv0ll2GOi05","executionInfo":{"status":"ok","timestamp":1795100531629,"user_tz":-330,"elapsed":3334,"user":{"displayName":"RUSHIKESH SHINDE","userId":"09839766731621436932"}},"outputId":"f0764395-7258-4fb5-a085-51d22b17c6a6"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["=== SIMPLE LINEAR REGRESSION COMPARISON (pm2_5 -> us_aqi) ===\n"]},{"output_type":"display_data","data":{"text/plain":["  Pipeline_Key                                 Model        MSE     RMSE  \\\n","0  slr_scratch  1a. Simple LR (Without Lib Pipeline)  3015.1584  54.9105   \n","1      slr_lib     1b. Simple LR (With Lib Pipeline)  3015.1584  54.9105   \n","\n","       MAE  R2_Score  Train_Time_s  \n","0  28.1791    0.5416        0.0344  \n","1  28.1791    0.5416        0.0283  "]