HOUT LIBRARY: Custom OOP Batch Gradient Descent Class ---\n","class GradientDescentRegressor(BaseRegressor):\n","    \"\"\"Iterative Batch Gradient Descent minimizing Mean Squared Error.\"\"\"\n","    def __init__(self, lr: float = 0.05, epochs: int = 1000):\n","        self.lr = lr\n","        self.epochs = epochs\n","\n","    def fit(self, X, y):\n","        X_b = self._add_bias(X)\n","        y_arr = np.asarray(y, dtype=float).ravel()\n","        n_samples, n_features = X_b.shape\n","        self.weights_ = np.zeros(n_features)\n","        self.loss_history_ = []\n","\n","        for _ in range(self.epochs):\n","            y_pred = X_b @ self.weights_\n","            error = y_pred - y_arr\n","            self.loss_history_.append(float(np.mean(error ** 2)))\n","            grad = (2.0 / n_samples) * (X_b.T @ error)\n","            self.weights_ -= self.lr * grad\n","        return self\n","\n","    def predict(self, X) -> np.ndarray:\n","        return self._add_bias(X) @ self.weights_\n","\n","gd_scratch_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    GradientDescentRegressor(lr=0.05, epochs=1000)\n",")\n","res_3a = benchmark_pipeline(\n","    \"gd_scratch\", \"3a. Gradient Descent (Without Lib Pipeline)\",\n","    gd_scratch_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- B. WITH LIBRARY: Scikit-Learn SGDRegressor Pipeline ---\n","gd_lib_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    SGDRegressor(max_iter=1000, learning_rate='invscaling', eta0=0.01, random_state=42)\n",")\n","res_3b = benchmark_pipeline(\n","    \"gd_lib\", \"3b. SGD Regressor (With Lib Pipeline)\",\n","    gd_lib_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- C. COMPARISON TABLE, LOSS CURVE & SEPARATE GRAPHS FOR BOTH ---\n","print(\"=== GRADIENT DESCENT REGRESSION COMPARISON ===\")\n","display(pd.concat([res_3a, res_3b], ignore_index=True))\n","\n","# 1. MSE Loss Convergence Plot\n","loss_curve = gd_scratch_pipe.named_steps['gradientdescentregressor'].loss_history_\n","plt.figure(figsize=(8, 3.6))\n","plt.plot(range(1, len(loss_curve) + 1), loss_curve, color='#9467bd', linewidth=2.2)\n","plt.title('Batch Gradient Descent MSE Convergence Curve (1,000 Epochs)')\n","plt.xlabel('Epoch')\n","plt.ylabel('Training Mean Squared Error (MSE)')\n","plt.grid(True, linestyle='--', alpha=0.5)\n","plt.tight_layout()\n","plt.savefig(os.path.join(FIG_DIR, '03a_gd_loss_curve.png'), dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","# 2. Separate Regression Line Graphs for Without Lib vs. With Lib\n","plot_without_vs_with_lib(\n","    algo_title=\"Gradient Descent Regression\",\n","    scratch_pipe=gd_scratch_pipe,\n","    lib_pipe=gd_lib_pipe,\n","    X_te_sub=X_test,\n","    y_te=y_test,\n","    save_name=\"03b_gd_without_vs_with_lib.png\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":893},"id":"3jv3wH2WPDKf","executionInfo":{"status":"ok","timestamp":1795100648758,"user_tz":-330,"elapsed":7031,"user":{"displayName":"RUSHIKESH SHINDE","userId":"09839766731621436932"}},"outputId":"10c2af4e-7eca-40e1-9c31-db1225bc62e8"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["=== GRADIENT DESCENT REGRESSION COMPARISON ===\n"]},{"output_type":"display_data","data":{"text/plain":["  Pipeline_Key                                        Model        MSE  \\\n","0   gd_scratch  3a. Gradient Descent (Without Lib Pipeline)  1735.5860   \n","1       gd_lib        3b. SGD Regressor (With Lib Pipeline)  1759.7241   \n","\n","      RMSE      MAE  R2_Score  Train_Time_s  \n","0  41.6604  21.9183    0.7362        2.3822  \n","1  41.9491  21.9075    0.7325        0.5884  "],"text/html":["\n","  <div id=\"df-61e0ca66-28a5-4f06-a842-c4f3ce96e5f6\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","