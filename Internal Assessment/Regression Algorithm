f} ± {cv_scratch.std():.4f}\")\n","print(f\"5-Fold CV R2 -> With Lib Ridge Pipeline   : {cv_lib.mean():.4f} ± {cv_lib.std():.4f}\")\n","\n","# 1. Master R2 Bar Chart Across All 10 Pipelines\n","plt.figure(figsize=(12, 5))\n","sns.barplot(data=master_df, y='Model', x='R2_Score', palette='viridis')\n","plt.title('Master Comparison: R² Score Across All 10 Pipelines (Without Lib vs. With Lib)')\n","plt.xlabel('R² Score (Higher is Better)')\n","plt.ylabel('')\n","plt.xlim(0, 0.85)\n","for container in plt.gca().containers:\n","    plt.gca().bar_label(container, fmt='%.4f', padding=4, fontsize=9)\n","plt.tight_layout()\n","plt.savefig(os.path.join(FIG_DIR, '06a_master_r2_bar_comparison.png'), dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","# 2. Side-by-Side Overlay of All 5 Regression Lines/Curves (Left: Without Lib | Right: With Lib)\n","fig, axes = plt.subplots(1, 2, figsize=(18, 6))\n","sample_idx = np.random.RandomState(42).choice(len(X_test), size=1500, replace=False)\n","\n","pm25_grid = np.linspace(X_test['pm2_5'].min(), X_test['pm2_5'].quantile(0.99), 200)\n","full_grid = pd.DataFrame(np.tile(X_test.median().values, (len(pm25_grid), 1)), columns=FEATURES)\n","full_grid['pm2_5'] = pm25_grid\n","\n","# Panel A: All 5 Without-Library (Scratch) Pipelines\n","axes[0].scatter(X_test['pm2_5'].iloc[sample_idx], y_test[sample_idx], alpha=0.18, s=12, color='gray', label='Test Data')\n","axes[0].plot(pm25_grid, slr_scratch_pipe.predict(full_grid[['pm2_5']]), '--', lw=2.2, label='1a. Simple LR (Scratch)')\n","axes[0].plot(pm25_grid, mlr_scratch_pipe.predict(full_grid), '-', lw=2.2, label='2a. Multiple LR (Scratch)')\n","axes[0].plot(pm25_grid, gd_scratch_pipe.predict(full_grid), ':', lw=2.5, label='3a. Gradient Descent (Scratch)')\n","axes[0].plot(pm25_grid, poly_scratch_pipe.predict(full_grid[POLY_FEATURES]), '-', lw=3.0, color='#d62728', label='4a. Poly Deg-2 Curve (Scratch)')\n","axes[0].plot(pm25_grid, ridge_scratch_pipe.predict(full_grid), '-.', lw=2.2, color='#2ca02c', label='5a. Ridge L2 (Scratch)')\n","axes[0].set_title('A. Without Library: All 5 Scratch Regression Lines & Curve')\n","axes[0].set_xlabel('PM2.5 Concentration (µg/m³)')\n","axes[0].set_ylabel('Predicted US AQI')\n","axes[0].legend(loc='upper left')\n","axes[0].grid(True, linestyle='--', alpha=0.5)\n","\n","# Panel B: All 5 With-Library (Sklearn) Pipelines\n","axes[1].scatter(X_test['pm2_5'].iloc[sample_idx], y_test[sample_idx], alpha=0.18, s=12, color='gray', label='Test Data')\n","axes[1].plot(pm25_grid, slr_lib_pipe.predict(full_grid[['pm2_5']]), '--', lw=2.2, label='1b. Simple LR (Sklearn)')\n","axes[1].plot(pm25_grid, mlr_lib_pipe.predict(full_grid), '-', lw=2.2, label='2b. Multiple LR (Sklearn)')\n","axes[1].plot(pm25_grid, gd_lib_pipe.predict(full_grid), ':', lw=2.5, label='3b. SGD Regressor (Sklearn)')\n","axes[1].plot(pm25_grid, poly_lib_pipe.predict(full_grid[POLY_FEATURES]), '-', lw=3.0, color='#1f77b4', label='4b. Poly Deg-2 Curve (Sklearn)')\n","axes[1].plot(pm25_grid, ridge_lib_pipe.predict(full_grid), '-.', lw=2.2, color='#2ca02c', label='5b. Ridge L2 (Sklearn)')\n","axes[1].set_title('B. With Library: All 5 Sklearn Regression Lines & Curve')\n","axes[1].set_xlabel('PM2.5 Concentration (µg/m³)')\n","axes[1].set_ylabel('Predicted US AQI')\n","axes[1].legend(loc='upper left')\n","axes[1].grid(True, linestyle='--', alpha=0.5)\n","\n","plt.tight_layout()\n","plt.savefig(os.path.join(FIG_DIR, '06b_all_models_overlay_without_vs_with_lib.png'), dpi=300, bbox_inches='tight')\n","plt.show()\n","\n","# 3. Export ALL 10 Separate Pipelines + Input Schemas to Google Drive\n","export_bundle = {\n","    'pipelines': pipelines_registry,          # All 10 separate make_pipeline objects\n","    'full_features': FEATURES,                # 22 inputs for MLR, GD, and Ridge pipelines\n","    'poly_features': POLY_FEATURES,           # 6 inputs for Polynomial pipelines\n","    'simple_feature': ['pm2_5'],              # 1 input for Simple LR pipelines\n","    'default_values': X_train[FEATURES].median().to_dict(),\n","    'leaderboard': master_df.to_dict(orient='records')\n","}\n","\n","bundle_path = os.path.join(MODELS_DIR, 'all_regression_pipelines.pkl')\n","leaderboard_csv_path = os.path.join(PROJECT_DIR, 'unit3_master_regression_leaderboard.csv')\n","\n","joblib.dump(export_bundle, bundle_path)\n","master_df.to_csv(leaderboard_csv_path, index=False)\n","\n","print(f\"\\nSaved all {len(pipelines_registry)} pipelines to: {bundle_path}\")\n","print(f\"Saved master leaderboard CSV to     : {leaderboard_csv_path}\")\n","print(f\"Saved all 300-DPI figures inside    : {FIG_DIR}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"c-yv0mIjPhrh","executionInfo":{"status":"ok","timestamp":1795101021227,"user_tz":-330,"elapsed":4867,"user":{"displayName":"RUSHIKESH SHINDE","userId":"09839766731621436932"}},"outputId":"e4d87f38-3dec-4dae-b6b1-3ad4c224a4d7"},"execution_count":31,"outputs":[{"output_type":"stream","name":"stdout","text":["=== MASTER REGRESSION PIPELINE LEADERBOARD (ALL 10 MODELS) ===\n"]},{"output_type":"display_data","data":{"text/plain":["     Pipeline_Key                                              Model  \\\n","0     slr_scratch               1a. Simple LR (Without Lib Pipeline)   \n","1         slr_lib                  1b. Simple LR (With Lib Pipeline)   \n","2     mlr_scratch             2a. Multiple LR (Without Lib Pipeline)   \n","3         mlr_lib                2b. Multiple LR (With Lib Pipeline)   \n","4      gd_scratch        3a. Gradient Descent (Without Lib Pipeline)   \n","5          gd_lib              3b. SGD Regressor (With Lib Pipeline)   \n","6   poly2_scratch  4a. Polynomial Deg-2 (Without Lib Solver Pipel...   \n","7       poly2_lib           4b. Polynomial Deg-2 (With Lib Pipeline)   \n","8   ridge_scratch       5a. Ridge L2 alpha=10 (Without Lib Pipeline)   \n","9       ridge_lib          5b. Ridge L2 alpha=10 (With Lib Pipeline)   \n","10  ridge_scratch       5a. Ri