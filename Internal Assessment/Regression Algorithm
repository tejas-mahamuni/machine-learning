"\"\"Closed-Form L2 Regularized Ridge Regression (Intercept unpenalized).\"\"\"\n","    def __init__(self, alpha: float = 10.0):\n","        self.alpha = alpha\n","\n","    def fit(self, X, y):\n","        X_b = self._add_bias(X)\n","        y_arr = np.asarray(y, dtype=float).ravel()\n","        reg_matrix = np.eye(X_b.shape[1])\n","        reg_matrix[0, 0] = 0.0  # Do not regularize bias term w0\n","        self.weights_ = np.linalg.pinv(X_b.T @ X_b + self.alpha * reg_matrix) @ X_b.T @ y_arr\n","        return self\n","\n","    def predict(self, X) -> np.ndarray:\n","        return self._add_bias(X) @ self.weights_\n","\n","ridge_scratch_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    RidgeRegressor(alpha=10.0)\n",")\n","res_5a = benchmark_pipeline(\n","    \"ridge_scratch\", \"5a. Ridge L2 alpha=10 (Without Lib Pipeline)\",\n","    ridge_scratch_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- B. WITH LIBRARY: Scikit-Learn Ridge Pipeline ---\n","ridge_lib_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    Ridge(alpha=10.0, random_state=42)\n",")\n","res_5b = benchmark_pipeline(\n","    \"ridge_lib\", \"5b. Ridge L2 alpha=10 (With Lib Pipeline)\",\n","    ridge_lib_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- C. COMPARISON TABLE & SEPARATE GRAPHS FOR BOTH ---\n","print(\"=== RIDGE REGRESSION (L2) COMPARISON (alpha = 10.0) ===\")\n","display(pd.concat([res_5a, res_5b], ignore_index=True))\n","\n","plot_without_vs_with_lib(\n","    algo_title=\"Ridge Regression (L2, alpha=10)\",\n","    scratch_pipe=ridge_scratch_pipe,\n","    lib_pipe=ridge_lib_pipe,\n","    X_te_sub=X_test,\n","    y_te=y_test,\n","    save_name=\"05a_ridge_without_vs_with_lib.png\"\n",")\n","\n","# L2 Weight Shrinkage Bar Chart (Unregularized MLR vs. Ridge L2)\n","mlr_w = mlr_scratch_pipe.named_steps['multiplelinearregressor'].weights_[1:]\n","ridge_w = ridge_scratch_pipe.named_steps['ridgeregressor'].weights_[1:]\n","\n","coef_comp = pd.DataFrame({\n","    'Feature': FEATURES,\n","    'Unregularized MLR': mlr_w,\n","    'Ridge L2 (alpha=10)': ridge_w\n","}).set_index('Feature').loc[['pm2_5', 'pm10', 'dust', 'temperature_2m', 'dew_point_2m', 'stagnation_index']]\n","\n","coef_comp.plot(kind='bar', figsize=(10, 4), color=['#ff7f0e', '#2ca02c'], edgecolor='black')\n","plt.title('L2 Regularization Effect: Standardized Weights (Unregularized MLR vs. Ridge)')\n","plt.ylabel('Weight Magnitude')\n","plt.xticks(rotation=25)\n","plt.grid(True, linestyle='--', alpha=0.5)\n","plt.tight_layout()\n","plt.savefig(os.path.join(FIG_DIR, '05b_ridge_weight_shrinkage.png'), dpi=300, bbox_inches='tight')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":883},"id":"lW21ymJ_Pbay","executionInfo":{"status":"ok","timestamp":1795100983784,"user_tz":-330,"elapsed":7974,"user":{"displayName":"RUSHIKESH SHINDE","userId":"09839766731621436932"}},"outputId":"fc2bd9a5-0a41-4be9-d2b2-e78c58fe0fbc"},"execution_count":30,"outputs":[{"output_type":"stream","name":"stdout","text":["=== RIDGE REGRESSION (L2) COMPARISON (alpha = 10.0) ===\n"]},{"output_type":"display_data","data":{"text/plain":["    Pipeline_Key                                         Model        MSE  \\\n","0  ridge_scratch  5a. Ridge L2 alpha=10 (Without Lib Pipeline)  1762.3507   \n","1      ridge_lib     5b. Ridge L2 alpha=10 (With Lib Pipeline)  1762.3507   \n","\n","      RMSE      MAE  R2_Score  Train_Time_s  \n","0  41.9804  21.9452    0.7321        0.3474  \n","1  41.9804  21.9452    0.7321        0.3328  "],"text/html":["\n","  <div id=\"df-1da9e67c-34d9-46a4-96a6-f165a8f9c116\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-al