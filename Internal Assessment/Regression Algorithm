  y_arr = np.asarray(y, dtype=float).ravel()\n","        self.weights_ = np.linalg.pinv(X_b.T @ X_b) @ X_b.T @ y_arr\n","        return self\n","\n","    def predict(self, X) -> np.ndarray:\n","        return self._add_bias(X) @ self.weights_\n","\n","mlr_scratch_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    MultipleLinearRegressor()\n",")\n","res_2a = benchmark_pipeline(\n","    \"mlr_scratch\", \"2a. Multiple LR (Without Lib Pipeline)\",\n","    mlr_scratch_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- B. WITH LIBRARY: Scikit-Learn Pipeline ---\n","mlr_lib_pipe = make_pipeline(\n","    SimpleImputer(strategy='median'),\n","    StandardScaler(),\n","    LinearRegression()\n",")\n","res_2b = benchmark_pipeline(\n","    \"mlr_lib\", \"2b. Multiple LR (With Lib Pipeline)\",\n","    mlr_lib_pipe, X_train, X_test, y_train, y_test\n",")\n","\n","# --- C. COMPARISON TABLE & SEPARATE GRAPHS FOR BOTH ---\n","print(\"=== MULTIPLE LINEAR REGRESSION COMPARISON (22 Features -> us_aqi) ===\")\n","display(pd.concat([res_2a, res_2b], ignore_index=True))\n","\n","plot_without_vs_with_lib(\n","    algo_title=\"Multiple Linear Regression (22 Features)\",\n","    scratch_pipe=mlr_scratch_pipe,\n","    lib_pipe=mlr_lib_pipe,\n","    X_te_sub=X_test,\n","    y_te=y_test,\n","    save_name=\"02_multiple_lr_without_vs_with_lib.png\"\n",")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":661},"id":"hG3N3iwJOeS7","executionInfo":{"status":"ok","timestamp":1795100613669,"user_tz":-330,"elapsed":6962,"user":{"displayName":"RUSHIKESH SHINDE","userId":"09839766731621436932"}},"outputId":"39372e51-fc64-4265-b315-08693f5ec6f7"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["=== MULTIPLE LINEAR REGRESSION COMPARISON (22 Features -> us_aqi) ===\n"]},{"output_type":"display_data","data":{"text/plain":["  Pipeline_Key                                   Model        MSE     RMSE  \\\n